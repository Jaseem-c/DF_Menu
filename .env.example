# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used ONLY by `npm run seed` on your own machine. Never expose it to the browser
# and never add it to Vercel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: public URL of the menu, used as the default for the QR code page.
NEXT_PUBLIC_SITE_URL=https://your-menu.vercel.app
